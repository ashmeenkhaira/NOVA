# Copy this file to .env and replace the placeholders with your real keys.
# Rules: one NAME=value per line, no quotes, no spaces around the =

# From console.groq.com -> API Keys
GROQ_API_KEY=your-groq-api-key-here

# From @BotFather on Telegram, after /newbot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
