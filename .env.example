# Copy this file to .env and replace the placeholders with your real keys.
# Rules: one NAME=value per line, no quotes, no spaces around the =

# From console.groq.com -> API Keys
GROQ_API_KEY=your-groq-api-key-here

# From @BotFather on Telegram, after /newbot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# Your own Telegram chat id, so the terminal chat shares your memories.
# Find it: run bot.py, message the bot, read the "[debug] message from chat ..." line.
MY_CHAT_ID=your-telegram-chat-id-here

# The OAuth client file downloaded from Google Cloud (Desktop app), relative
# to this folder. Keep the file itself out of git.
GOOGLE_CREDENTIALS_FILE=credentials.json

# --- Optional: let other people link their own Google account ---------------
# Leave these out and /connect simply asks the owner to link accounts by hand.
#
# A second OAuth client, this one of type "Web application", with
# <PUBLIC_BASE_URL>/connected registered as an authorised redirect URI.
# GOOGLE_WEB_CREDENTIALS_FILE=credentials_web.json
#
# Where Google sends people back to. http://localhost:8000 works while testing
# on your own machine; a deployed bot needs a public https address.
# PUBLIC_BASE_URL=http://localhost:8000
#
# The local port the callback server listens on. Behind a reverse proxy this
# stays a plain local port while the proxy handles https on 443.
# OAUTH_PORT=8000
