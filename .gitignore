# Secrets - must never reach GitHub
.env

# Google OAuth files: the app's credentials (downloaded from Google Cloud)
# and the saved login token (created on first sign-in)
credentials.json
token.json

# The virtual environment - anyone can rebuild it with: py -m venv venv
venv/

# Python's cache of pre-compiled files - recreated automatically
__pycache__/

# pytest's cache - recreated on every test run
.pytest_cache/

# Databases - they will hold personal details about you
*.db
